# Copy this file to device/.env and fill in your values.
# Never commit serviceAccount.json or device/.env.

# Use the same PostgreSQL-backed Carebot API as the caregiver app.
SCAN_DATA_SOURCE=carebot
CAREBOT_API_BASE_URL=http://127.0.0.1:8000
CAREBOT_PATIENT_ID=
TIMEZONE=America/Vancouver

# These are only needed when SCAN_DATA_SOURCE=firebase.
FIREBASE_CREDENTIALS_PATH=serviceAccount.json
SENIOR_ID=
CAMERA_INDEX=0
MOCK_HARDWARE=false
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.8-flash
VISION_FALLBACK_MODEL=
# Reuse the same Gemini key as the laptop voice agent if desired.
VISION_API_KEY=

# Laptop webcam scan audio output through the Pi JBL bridge.
CAREBOT_PI_AUDIO_URL=http://192.168.2.2:8765/play
CAREBOT_AUDIO_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
